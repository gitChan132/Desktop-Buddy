{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "For Frog's Sake",
  "version": "0.1.0",
  "identifier": "com.forfrogsake.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "For Frog's Sake",
        "width": 340,
        "height": 420,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "backgroundColor": "#00000000",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-background-timer-throttling --disable-backgrounding-occluded-windows --disable-renderer-backgrounding"
      },
      {
        "label": "panel",
        "title": "For Frog's Sake Controls",
        "width": 272,
        "height": 360,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "visible": false,
        "focus": true,
        "backgroundColor": "#00000000",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-background-timer-throttling --disable-backgrounding-occluded-windows --disable-renderer-backgrounding"
      },
      {
        "label": "pond",
        "title": "Pond Settings",
        "width": 760,
        "height": 540,
        "resizable": false,
        "maximizable": false,
        "decorations": true,
        "transparent": false,
        "shadow": true,
        "skipTaskbar": false,
        "visible": false,
        "focus": true,
        "backgroundColor": "#0b3a1f",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-background-timer-throttling --disable-backgrounding-occluded-windows --disable-renderer-backgrounding"
      },
      {
        "label": "remote",
        "title": "Trigger Remote",
        "width": 232,
        "height": 344,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": false,
        "focus": true,
        "backgroundColor": "#00000000",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --disable-background-timer-throttling --disable-backgrounding-occluded-windows --disable-renderer-backgrounding"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
